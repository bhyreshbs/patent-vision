# The app calls the API at /api on its own origin (same domain on Vercel, proxied to uvicorn by `next dev`).
# Only set this to call a different API origin directly.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Where `next dev` proxies /api/* (default http://127.0.0.1:8000)
# API_PROXY_TARGET=http://127.0.0.1:8000

# Copy to .env and adjust. All variables use the PV_ prefix.
PV_DATABASE_URL=sqlite:///./patentvision.db
PV_STORAGE_ROOT=./storage
PV_SECRET_KEY=change-me-to-a-long-random-string
PV_ACCESS_TOKEN_MINUTES=1440
PV_MAX_UPLOAD_BYTES=15728640
PV_PROCESSING_MAX_SIDE=1600
# classical (default, no model files needed) or sam (needs torch + segment-anything + checkpoint)
PV_SEGMENTER=classical
# PV_SAM_CHECKPOINT=./checkpoints/sam_vit_b_01ec64.pth
# PV_SAM_MODEL_TYPE=vit_b
# false (default) = strict outer outline only. true = also keep large see-through openings (mug handles).
PV_KEEP_OPENINGS=false
PV_RATE_LIMIT_PER_MINUTE=60
PV_MAX_CONCURRENT_JOBS=2
PV_CORS_ORIGINS=["http://localhost:3000"]
